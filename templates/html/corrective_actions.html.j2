<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>OraHealthCheck Acciones Correctivas - {{ target.target_id }}</title>
  <style>
    :root{--bg:#f4f7fb;--surface:#fff;--text:#172033;--muted:#637083;--line:#dfe7f1;--shadow:0 8px 22px rgba(23,32,51,.07);--pass:#15803d;--pass-bg:#dcfce7;--info:#1d4ed8;--info-bg:#dbeafe;--warning:#b45309;--warning-bg:#fef3c7;--fail:#dc2626;--fail-bg:#fee2e2;--critical:#7f1d1d;--critical-bg:#fecaca;--error:#581c87;--error-bg:#f3e8ff;--skipped:#64748b;--skipped-bg:#f1f5f9}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;font-size:13px;line-height:1.35}.page{max-width:1440px;margin:0 auto;padding:20px 16px}.hero{background:linear-gradient(135deg,#13213a,#234876);color:#fff;border-radius:18px;padding:20px 24px;box-shadow:var(--shadow)}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:.72rem;opacity:.78}.hero h1{margin:.2rem 0;font-size:1.55rem}.hero p{margin:.35rem 0}.hero-grid,.cards,.info-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:9px}.hero-grid{margin-top:14px}.hero-item{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);border-radius:12px;padding:10px 12px}.hero-item span,.info-item span{display:block;font-size:.72rem;opacity:.72}.section{background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:16px 18px;margin-top:16px}.section h2{margin:0 0 6px;font-size:1.25rem}.hint{color:var(--muted);font-size:.86rem;margin-top:0}.card,.info-item{background:#fff;border:1px solid var(--line);border-radius:12px;padding:10px 12px;box-shadow:0 3px 12px rgba(23,32,51,.04)}.info-item strong{display:block;margin-top:2px;word-break:break-word}.card .label{color:var(--muted);font-size:.74rem}.card .value{font-size:1.35rem;font-weight:800}.badge{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:4px 8px;font-weight:700;font-size:11px;white-space:nowrap;border:1px solid transparent}.badge.PASS{color:var(--pass);background:var(--pass-bg);border-color:#bbf7d0}.badge.INFO{color:var(--info);background:var(--info-bg);border-color:#bfdbfe}.badge.WARNING{color:var(--warning);background:var(--warning-bg);border-color:#fde68a}.badge.FAIL{color:var(--fail);background:var(--fail-bg);border-color:#fecaca}.badge.CRITICAL{color:var(--critical);background:var(--critical-bg);border-color:#fca5a5}.badge.ERROR{color:var(--error);background:var(--error-bg);border-color:#e9d5ff}.badge.SKIPPED{color:var(--skipped);background:var(--skipped-bg);border-color:#e2e8f0}.owner{margin-top:16px;border:1px solid var(--line);border-radius:16px;overflow:hidden}.owner h3{margin:0;background:#eef4ff;padding:10px 12px;font-size:1rem}.action{padding:13px;border-top:1px solid var(--line);display:grid;grid-template-columns:190px 1fr;gap:14px}.meta{background:#f8fafc;border:1px solid var(--line);border-radius:12px;padding:10px}.meta div{margin:5px 0}.summary{font-size:.95rem}.actions{margin:8px 0 0 1.1rem;padding:0}.actions li{margin:3px 0}.evidence{background:#f8fafc;border-left:4px solid #cbd5e1;padding:10px;border-radius:10px;color:#475569;word-break:break-word}.positive{border-left:5px solid var(--pass);background:#f0fdf4;padding:12px;border-radius:12px}@media(max-width:760px){.page{padding:14px 10px}.hero{padding:16px}.action{grid-template-columns:1fr}}
  </style>
</head>
<body>
{% macro badge(status) -%}
  <span class="badge {{ status }}">{% if status == 'PASS' %}🟢{% elif status == 'INFO' %}🔵{% elif status == 'WARNING' %}🟡{% elif status == 'FAIL' %}🔴{% elif status == 'CRITICAL' %}🛑{% elif status == 'ERROR' %}🟣{% else %}⚪{% endif %} {{ status }} / {{ status | status_label }}</span>
{%- endmacro %}
<div class="page">
  <header class="hero"><div class="eyebrow">OraHealthCheck</div><h1>Acciones Correctivas</h1><p>Reporte orientado a acciones para validaciones Fallo, Crítico, Advertencia y Error.</p><div class="hero-grid"><div class="hero-item"><span>ID del target</span><strong>{{ target.target_id }}</strong></div><div class="hero-item"><span>Ambiente</span><strong>{{ target.environment }}</strong></div><div class="hero-item"><span>Arquitectura esperada</span><strong>{{ target.expected_architecture }}</strong></div><div class="hero-item"><span>Perfil</span><strong>{{ target.profile }}</strong></div><div class="hero-item"><span>Fecha/hora de ejecución</span><strong>{{ generated_at }}</strong></div><div class="hero-item"><span>Estado Global</span><strong>{{ summary.global_status }} / {{ summary.global_status | status_label }}</strong></div></div></header>

  <section class="section"><h2>Información del target</h2><h3>Datos generales</h3><div class="info-grid">{% for item in target_info.general %}<div class="info-item"><span>{{ item.label }}</span><strong>{{ item.value }}</strong></div>{% endfor %}</div>{% if target_info.database %}<h3>Datos de base de datos</h3><div class="info-grid">{% for item in target_info.database %}<div class="info-item"><span>{{ item.label }}</span><strong>{{ item.value }}</strong></div>{% endfor %}</div>{% endif %}{% if target_info.operating_system %}<h3>Datos del servidor / sistema operativo</h3><div class="info-grid">{% for item in target_info.operating_system %}<div class="info-item"><span>{{ item.label }}</span><strong>{{ item.value }}</strong></div>{% endfor %}</div>{% endif %}</section>

  <section class="section"><h2>Resumen de Estados</h2><p class="hint">Use este reporte para planificar remediaciones. Requiere ventana indica si se recomienda una ventana de mantenimiento aprobada; Riesgo de indisponibilidad resume la exposición operativa esperada.</p><div class="cards"><div class="card"><div class="label">Puntaje de Salud</div><div class="value">{{ summary.score }}</div></div><div class="card"><div class="label">Estado Global</div><div class="value" style="font-size:1.1rem">{{ badge(summary.global_status) }}</div></div><div class="card"><div class="label">Advertencia</div><div class="value">{{ summary.WARNING }}</div></div><div class="card"><div class="label">Fallo</div><div class="value">{{ summary.FAIL }}</div></div><div class="card"><div class="label">Crítico</div><div class="value">{{ summary.CRITICAL }}</div></div><div class="card"><div class="label">Error</div><div class="value">{{ summary.ERROR }}</div></div></div></section>

  <section class="section">
    <h2>Acciones correctivas</h2>
    {% if corrective_actions %}{% for owner, owner_results in corrective_actions.items() %}<div class="owner"><h3>Responsable: {{ owner }}</h3>{% for result in owner_results %}<article class="action"><aside class="meta"><div>{{ badge(result.status.value) }}</div><div><strong>Severidad:</strong> {{ result.failure_severity | status_label }}</div><div><strong>Validación afectada:</strong> {{ result.check_id }}</div><div><strong>Requiere ventana:</strong> {{ result.remediation.requires_window if result.remediation.requires_window is defined else false }}</div><div><strong>Riesgo de indisponibilidad:</strong> {{ result.remediation.outage_risk or 'desconocido' }}</div></aside><div><h4>{{ result.title | check_title }}</h4><p class="summary"><strong>Resumen del problema:</strong> {{ result.remediation.summary or result.message or result.error }}</p><strong>Acciones recomendadas:</strong><ul class="actions">{% for action in result.remediation.actions or [] %}<li>{{ action }}</li>{% else %}<li>Revisar la evidencia y definir un plan de remediación con el responsable.</li>{% endfor %}</ul><p class="evidence"><strong>Evidencia resumida:</strong> {{ (result.message or result.error or result.skipped_reason) | friendly_message }}{% if result.evidence is not none %} — {{ result.evidence | pretty_json | truncate(260) }}{% endif %}</p></div></article>{% endfor %}</div>{% endfor %}{% else %}<div class="positive"><strong>No se requieren acciones correctivas.</strong> No se detectaron validaciones en Fallo, Crítico, Advertencia o Error.</div>{% endif %}
  </section>
</div>
</body>
</html>
