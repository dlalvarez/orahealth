<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>OraHealthCheck Executive Report - {{ target.target_id }}</title>
  <style>
    :root{--bg:#f4f7fb;--surface:#fff;--text:#172033;--muted:#637083;--line:#dfe7f1;--shadow:0 10px 30px rgba(23,32,51,.08);--pass:#15803d;--pass-bg:#dcfce7;--info:#1d4ed8;--info-bg:#dbeafe;--warning:#b45309;--warning-bg:#fef3c7;--fail:#dc2626;--fail-bg:#fee2e2;--critical:#7f1d1d;--critical-bg:#fecaca;--error:#581c87;--error-bg:#f3e8ff;--skipped:#64748b;--skipped-bg:#f1f5f9}
    *{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;line-height:1.5}.page{max-width:1180px;margin:0 auto;padding:32px 20px}.hero{background:linear-gradient(135deg,#13213a,#234876);color:#fff;border-radius:24px;padding:30px;box-shadow:var(--shadow)}.eyebrow{font-size:.78rem;text-transform:uppercase;letter-spacing:.12em;opacity:.78}.hero h1{margin:.25rem 0;font-size:2.1rem}.hero-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-top:22px}.hero-item{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);border-radius:16px;padding:12px}.hero-item span{display:block;font-size:.76rem;opacity:.72}.hero-item strong{display:block;margin-top:3px}.section{background:var(--surface);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);padding:24px;margin-top:22px}.section h2{margin:0 0 8px}.hint{color:var(--muted);font-size:.94rem;margin-top:0}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-top:16px}.card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:18px;box-shadow:0 4px 16px rgba(23,32,51,.04)}.card .label{color:var(--muted);font-size:.84rem}.card .value{font-size:2rem;font-weight:800;margin-top:4px}.score-card{background:linear-gradient(180deg,#fff,#f8fbff)}.score-card .value{font-size:3.2rem}.badge{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:6px 11px;font-weight:700;font-size:.78rem;white-space:nowrap;border:1px solid transparent}.badge.PASS{color:var(--pass);background:var(--pass-bg);border-color:#bbf7d0}.badge.INFO{color:var(--info);background:var(--info-bg);border-color:#bfdbfe}.badge.WARNING{color:var(--warning);background:var(--warning-bg);border-color:#fde68a}.badge.FAIL{color:var(--fail);background:var(--fail-bg);border-color:#fecaca}.badge.CRITICAL{color:var(--critical);background:var(--critical-bg);border-color:#fca5a5}.badge.ERROR{color:var(--error);background:var(--error-bg);border-color:#e9d5ff}.badge.SKIPPED{color:var(--skipped);background:var(--skipped-bg);border-color:#e2e8f0}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:16px}table{width:100%;border-collapse:collapse;background:#fff}th,td{padding:13px 14px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top}th{background:#f8fafc;color:#475569;font-size:.78rem;text-transform:uppercase;letter-spacing:.06em}tr:last-child td{border-bottom:0}.finding-title{font-weight:800}.severity{font-weight:700;color:#334155}.positive{border-left:6px solid var(--pass);background:#f0fdf4;padding:16px;border-radius:14px}@media(max-width:700px){.page{padding:18px 12px}.hero{padding:22px}.score-card .value{font-size:2.4rem}th,td{padding:10px}}
  </style>
</head>
<body>
{% macro badge(status) -%}
  <span class="badge {{ status }}">{% if status == 'PASS' %}🟢{% elif status == 'INFO' %}🔵{% elif status == 'WARNING' %}🟡{% elif status == 'FAIL' %}🔴{% elif status == 'CRITICAL' %}🛑{% elif status == 'ERROR' %}🟣{% else %}⚪{% endif %} {{ status }}</span>
{%- endmacro %}
<div class="page">
  <header class="hero">
    <div class="eyebrow">OraHealthCheck</div>
    <h1>Executive Report</h1>
    <p>Executive overview for {{ target.name }} with a fast interpretation of health score, global status, and priority findings.</p>
    <div class="hero-grid">
      <div class="hero-item"><span>Target ID</span><strong>{{ target.target_id }}</strong></div>
      <div class="hero-item"><span>Target name</span><strong>{{ target.name }}</strong></div>
      <div class="hero-item"><span>Environment</span><strong>{{ target.environment }}</strong></div>
      <div class="hero-item"><span>Expected architecture</span><strong>{{ target.expected_architecture }}</strong></div>
      <div class="hero-item"><span>Profile</span><strong>{{ target.profile }}</strong></div>
      <div class="hero-item"><span>Execution time</span><strong>{{ generated_at }}</strong></div>
    </div>
  </header>

  <section class="section">
    <h2>Executive Overview</h2>
    <p class="hint">The score starts at 100 and decreases when WARNING, FAIL, CRITICAL, or ERROR results are found. The global status highlights the highest operational risk observed.</p>
    <div class="cards">
      <div class="card score-card"><div class="label">Health Score</div><div class="value">{{ summary.score }}</div></div>
      <div class="card"><div class="label">Global Status</div><div class="value" style="font-size:1.2rem">{{ badge(summary.global_status) }}</div></div>
      <div class="card"><div class="label">Total checks</div><div class="value">{{ summary.total_checks }}</div></div>
      <div class="card"><div class="label">PASS</div><div class="value">{{ summary.PASS }}</div></div>
      <div class="card"><div class="label">INFO</div><div class="value">{{ summary.INFO }}</div></div>
      <div class="card"><div class="label">FAIL</div><div class="value">{{ summary.FAIL }}</div></div>
      <div class="card"><div class="label">CRITICAL</div><div class="value">{{ summary.CRITICAL }}</div></div>
      <div class="card"><div class="label">WARNING</div><div class="value">{{ summary.WARNING }}</div></div>
      <div class="card"><div class="label">ERROR</div><div class="value">{{ summary.ERROR }}</div></div>
      <div class="card"><div class="label">SKIPPED</div><div class="value">{{ summary.SKIPPED }}</div></div>
    </div>
  </section>

  <section class="section">
    <h2>Executive Summary</h2>
    {% if findings %}
      <p>{{ findings|length }} priority finding(s) require review. Critical, error, fail, and warning items are presented first so remediation can be prioritized.</p>
    {% else %}
      <div class="positive"><strong>All evaluated checks are healthy.</strong> No critical executive findings were detected for this target.</div>
    {% endif %}
  </section>

  <section class="section">
    <h2>Main Findings</h2>
    {% if findings %}
    <div class="table-wrap"><table>
      <thead><tr><th>Status</th><th>Group</th><th>Check</th><th>Message</th><th>Impact / Severity</th><th>Recommended action</th></tr></thead>
      <tbody>
      {% for result in findings %}
        <tr>
          <td>{{ badge(result.status.value) }}</td><td>{{ result.group_id }}</td><td><div class="finding-title">{{ result.title }}</div><small>{{ result.check_id }}</small></td>
          <td>{{ result.message or result.error or result.skipped_reason }}</td><td class="severity">{{ result.failure_severity }}</td><td>{{ result.remediation.summary or 'Review the check evidence and confirm operational impact.' }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table></div>
    {% else %}<div class="positive">No main findings to report. The target is in a healthy state based on the executed profile.</div>{% endif %}
  </section>
</div>
</body>
</html>
