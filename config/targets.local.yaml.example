# Copy this file to config/targets.local.yaml and keep the .local.yaml file out of Git.
# target_id values matching config/targets.yaml replace the base target definition.

targets:
  - target_id: lab_standalone
    name: Lab Standalone Database
    environment: lab
    expected_architecture: standalone
    profile: standalone_basic
    database:
      primary_connection: lab_oracle
    operating_system:
      platform: linux
      connections:
        - lab_oracle_host
    features:
      diagnostic_pack: false
      awr: false
      sysdba: false
